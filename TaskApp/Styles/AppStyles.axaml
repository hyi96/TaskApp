<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <x:Double x:Key="ScrollBarSize">10</x:Double>
        <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="Transparent"/>
        <SolidColorBrush x:Key="ScrollViewerScrollBarsSeparatorBackground" Color="Transparent"/>
    </Styles.Resources>

    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>
    <Style Selector="TextBox, ListBox">
        <Setter Property="ScrollViewer.AllowAutoHide" Value="False"/>
    </Style>
    <Style Selector="ScrollBar">
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>
    <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton, ScrollBar /template/ RepeatButton#PART_LineDownButton">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="CornerRadius" Value="5"/>
    </Style>
    
    <!-- Smaller ComboBox style for sort dropdowns -->
    <Style Selector="ComboBox.sort-dropdown">
        <Setter Property="MinWidth" Value="130"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Height" Value="28"/>
    </Style>
    
    <!-- Column title style -->
    <Style Selector="TextBlock.column-title">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    
    <!-- Window title bar button styles -->
    <Style Selector="Button.window-control">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    
    <Style Selector="Button.window-control:pointerover">
        <Setter Property="Background" Value="#20000000"/>
    </Style>
    
    <Style Selector="Button.window-close">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    
    <Style Selector="Button.window-close:pointerover">
        <Setter Property="Background" Value="#E81123"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    
</Styles>
