<Window xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:TaskApp.ViewModels"
xmlns:sys="using:System"
mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
x:Class="TaskApp.Views.TagsWindow"
x:DataType="vm:TagsViewModel"
Icon="/Assets/app-icon.png"
Title="Tags Manager"
Width="400" Height="500"
WindowStartupLocation="CenterOwner"
Background="{DynamicResource AppBackgroundBrush}">
    <Border Padding="16">
        <Grid RowDefinitions="Auto,*,Auto">
            
            <TextBlock Text="Manage Tags"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,16"
                       Foreground="{DynamicResource AppTextBrush}"/>

            <!-- List of Tags -->
            <ScrollViewer Grid.Row="1" Margin="0,0,12,16">
                <ItemsControl ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SelectableTag">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                                <CheckBox Grid.Column="0" 
                                          IsChecked="{Binding IsSelected}" 
                                          VerticalAlignment="Center" 
                                          Margin="0,0,4,0"/>
                                <TextBox Grid.Column="1" 
                                         Text="{Binding Name}" 
                                         VerticalAlignment="Center"
                                         FontSize="16"
                                         KeyDown="TagName_KeyDown"
                                         LostFocus="TagName_LostFocus"
                                         Margin="0,0,8,0"/>
                                <Button Grid.Column="2" 
                                        Content="X"
                                        Background="#B00020"
                                        Foreground="White"
                                        Click="RemoveTag_Click"
                                        Margin="4,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Add Tag Section -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <TextBox Watermark="New tag name..." 
                         Margin="0,0,8,0"
                         Text="{Binding NewTagValue}"
                         KeyDown="AddTag_KeyDown"/>
                <Button Grid.Column="1" 
                        Content="Add Tag"
                        Command="{Binding AddTag}"/>
            </Grid>
        </Grid>
    </Border>
</Window>

