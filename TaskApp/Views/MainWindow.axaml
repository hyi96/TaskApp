<Window xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:TaskApp.ViewModels"
xmlns:tasks="using:TaskApp.Models.Tasks"
xmlns:rewards="using:TaskApp.Models.Rewards"
xmlns:conv="using:TaskApp.Converters"
mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
x:Class="TaskApp.Views.MainWindow"
x:Name="MainWindowRoot"
x:DataType="vm:MainWindowViewModel"
Icon="/Assets/app-icon.png"
Width="1280"
Height="850"
MinWidth="900"
MinHeight="550"
Title="TaskApp"
Background="{DynamicResource AppBackgroundBrush}">
<Window.Resources>
    <conv:BooleanNegationConverter x:Key="InverseBooleanConverter" />
    <conv:BooleanToTextDecorationConverter x:Key="BoolToTextDecorationConverter" />
    <conv:BooleanToOpacityConverter x:Key="BoolToOpacityConverter" />
    <conv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <conv:NotNullAndBooleanMultiConverter x:Key="NotNullAndBooleanMultiConverter" />
    <conv:FilterTabForegroundConverter x:Key="FilterTabForegroundConverter" />
    <conv:FilterTabFontWeightConverter x:Key="FilterTabFontWeightConverter" />
    <conv:FilterTabTextDecorationConverter x:Key="FilterTabTextDecorationConverter" />
    <conv:FilterTabOpacityConverter x:Key="FilterTabOpacityConverter" />
    <conv:TodoOverdueForegroundMultiConverter x:Key="TodoOverdueForegroundConverter" />
    <conv:HiddenToggleLabelConverter x:Key="HiddenToggleLabelConverter" />
    <conv:DueDateDisplayConverter x:Key="DueDateDisplayConverter" />
</Window.Resources>
<Grid RowDefinitions="Auto,*,Auto" Margin="16">
<!-- Header Row -->
<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="0,0,0,12">
    <TextBlock Grid.Column="0"
               Text="TaskApp"
               FontSize="28"
               FontWeight="Bold"
               VerticalAlignment="Center"
               Foreground="{DynamicResource AppTextBrush}"/>

    <CheckBox Grid.Column="1"
              Content="Verbose"
              IsChecked="{Binding IsVerbose}"
              VerticalAlignment="Center"
              Margin="16,0,0,0"/>

    <StackPanel Grid.Column="2"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="8">
        <TextBox Width="300" Watermark="Search tasks..." Text="{Binding SearchQuery}"/>
        <Button Content="Tags"
                Click="OpenTagsWindow_Click"/>
    </StackPanel>

    <Button Grid.Column="3"
            Content="Graphs"
            Click="OpenGraphWindow_Click"
            VerticalAlignment="Center"/>

    <Button Grid.Column="4"
            Content="Logs"
            Click="OpenLogsWindow_Click"
            VerticalAlignment="Center"/>

    <Button Grid.Column="5"
            Content="Settings"
            Click="OpenSettingsWindow_Click"
            VerticalAlignment="Center"/>
</Grid>

<Grid Grid.Row="1" ColumnDefinitions="*,*,*,*">
        <!-- Habits -->
        <Border Grid.Column="0"
                Background="{DynamicResource ColumnBackgroundBrush}"
                CornerRadius="6"
                    Padding="12"
                    Margin="0,0,6,0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid RowDefinitions="Auto,Auto" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Text="Habits"
                                       Classes="column-title"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextBrush}"/>
                            <ComboBox Grid.Column="1"
                                      Classes="sort-dropdown"
                                      ItemsSource="{Binding HabitsSortOptions}"
                                      SelectedItem="{Binding HabitsSortMode}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Click="HabitsFilterTab_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Tag="all"
                                    Opacity="{Binding HabitsFilter, Converter={StaticResource FilterTabOpacityConverter}, ConverterParameter=all}"
                                    FontWeight="{Binding HabitsFilter, Converter={StaticResource FilterTabFontWeightConverter}, ConverterParameter=all}">
                                <TextBlock Text="all"
                                           TextDecorations="{Binding HabitsFilter, Converter={StaticResource FilterTabTextDecorationConverter}, ConverterParameter=all}"/>
                            </Button>
                            <Button Click="HabitsFilterTab_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Tag="hidden"
                                    Opacity="{Binding HabitsFilter, Converter={StaticResource FilterTabOpacityConverter}, ConverterParameter=hidden}"
                                    FontWeight="{Binding HabitsFilter, Converter={StaticResource FilterTabFontWeightConverter}, ConverterParameter=hidden}">
                                <TextBlock Text="hidden"
                                           TextDecorations="{Binding HabitsFilter, Converter={StaticResource FilterTabTextDecorationConverter}, ConverterParameter=hidden}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBox Grid.Row="1" Watermark="Add Habit"
                             HorizontalAlignment="Stretch"
                             Text="{Binding NewHabitTitle}"
                             KeyDown="AddHabit_KeyDown"
                             Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Habits}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="tasks:HabitTask">
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                        <Button Grid.Column="0" 
                                                Click="EditTask_Click" 
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="8,6">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding}">
                                                    <MenuItem Header="Set as Current Activity" Click="ContextMenu_SetCurrentActivity_Click"/>
                                                    <MenuItem Header="{Binding IsHidden, Converter={StaticResource HiddenToggleLabelConverter}}"
                                                              Click="ContextMenu_ToggleHidden_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid RowDefinitions="Auto,Auto">
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding ResetCadence, StringFormat='Resets: {0}'}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,4,0,0"
                                                           IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsVerbose}"/>
                                            </Grid>
                                        </Button>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding Count}" VerticalAlignment="Center" Margin="0,0,4,0" MinWidth="20" TextAlignment="Center"/>
                                            <Button Content="+" Click="IncrementHabit_Click" Padding="8,4" VerticalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Dailies -->
            <Border Grid.Column="1"
                    Background="{DynamicResource ColumnBackgroundBrush}"
                    CornerRadius="6"
                    Padding="12"
                    Margin="6,0,6,0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid RowDefinitions="Auto,Auto" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Text="Dailies"
                                       Classes="column-title"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextBrush}"/>
                            <ComboBox Grid.Column="1"
                                      Classes="sort-dropdown"
                                      ItemsSource="{Binding DailiesSortOptions}"
                                      SelectedItem="{Binding DailiesSortMode}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Click="DailiesFilterTab_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Tag="all"
                                    Opacity="{Binding DailiesFilter, Converter={StaticResource FilterTabOpacityConverter}, ConverterParameter=all}"
                                    FontWeight="{Binding DailiesFilter, Converter={StaticResource FilterTabFontWeightConverter}, ConverterParameter=all}">
                                <TextBlock Text="all"
                                           TextDecorations="{Binding DailiesFilter, Converter={StaticResource FilterTabTextDecorationConverter}, ConverterParameter=all}"/>
                            </Button>
                            <Button Click="DailiesFilterTab_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Tag="due"
                                    Opacity="{Binding DailiesFilter, Converter={StaticResource FilterTabOpacityConverter}, ConverterParameter=due}"
                                    FontWeight="{Binding DailiesFilter, Converter={StaticResource FilterTabFontWeightConverter}, ConverterParameter=due}">
                                <TextBlock Text="due"
                                           TextDecorations="{Binding DailiesFilter, Converter={StaticResource FilterTabTextDecorationConverter}, ConverterParameter=due}"/>
                            </Button>
                            <Button Click="DailiesFilterTab_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Tag="not due"
                                    Opacity="{Binding DailiesFilter, Converter={StaticResource FilterTabOpacityConverter}, ConverterParameter='not due'}"
                                    FontWeight="{Binding DailiesFilter, Converter={StaticResource FilterTabFontWeightConverter}, ConverterParameter='not due'}">
                                <TextBlock Text="not due"
                                           TextDecorations="{Binding DailiesFilter, Converter={StaticResource FilterTabTextDecorationConverter}, ConverterParameter='not due'}"/>
                            </Button>
                            <Button Click="DailiesFilterTab_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Tag="hidden"
                                    Opacity="{Binding DailiesFilter, Converter={StaticResource FilterTabOpacityConverter}, ConverterParameter=hidden}"
                                    FontWeight="{Binding DailiesFilter, Converter={StaticResource FilterTabFontWeightConverter}, ConverterParameter=hidden}">
                                <TextBlock Text="hidden"
                                           TextDecorations="{Binding DailiesFilter, Converter={StaticResource FilterTabTextDecorationConverter}, ConverterParameter=hidden}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBox Grid.Row="1" Watermark="Add Daily"
                             HorizontalAlignment="Stretch"
                             Text="{Binding NewDailyTitle}"
                             KeyDown="AddDaily_KeyDown"
                             Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Dailies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="tasks:DailyTask">
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                        <Button Grid.Column="0" 
                                                Click="EditTask_Click" 
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="8,6"
                                                Opacity="{Binding IsCompleteForCurrentPeriod, Converter={StaticResource BoolToOpacityConverter}}">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding}">
                                                    <MenuItem Header="Set as Current Activity" Click="ContextMenu_SetCurrentActivity_Click"/>
                                                    <MenuItem Header="{Binding IsHidden, Converter={StaticResource HiddenToggleLabelConverter}}"
                                                              Click="ContextMenu_ToggleHidden_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid RowDefinitions="Auto,Auto">
                                                <TextBlock Text="{Binding Title}"
                                                           TextWrapping="Wrap"
                                                           TextDecorations="{Binding IsCompleteForCurrentPeriod, Converter={StaticResource BoolToTextDecorationConverter}}"/>
                                                <Grid Grid.Row="1" 
                                                      ColumnDefinitions="*,*"
                                                      Margin="0,4,0,0"
                                                      IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsVerbose}">
                                                    <TextBlock Text="{Binding CurrentPeriodEndDate, StringFormat='Due: {0:MMM d}'}"
                                                               FontSize="11"
                                                               HorizontalAlignment="Left"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding CurrentStreak, StringFormat='Streak: {0}'}"
                                                               FontSize="11"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                </Grid>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Content="&#x2713;" Click="CompleteTask_Click" Margin="4,0,0,0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsEnabled="{Binding IsCompleteForCurrentPeriod, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- To-dos -->
            <Border Grid.Column="2"
                    Background="{DynamicResource ColumnBackgroundBrush}"
                    CornerRadius="6"
                    Padding="12"
                    Margin="6,0,6,0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid RowDefinitions="Auto,Auto" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Text="To-dos"
                                       Classes="column-title"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextBrush}"/>
                            <ComboBox Grid.Column="1"
                                      Classes="sort-dropdown"
                                      ItemsSource="{Binding TodosSortOptions}"
                                      SelectedItem="{Binding TodosSortMode}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Click="TodosFilterTab_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Tag="active"
                                    Opacity="{Binding TodosFilter, Converter={StaticResource FilterTabOpacityConverter}, ConverterParameter=active}"
                                    FontWeight="{Binding TodosFilter, Converter={StaticResource FilterTabFontWeightConverter}, ConverterParameter=active}">
                                <TextBlock Text="active"
                                           TextDecorations="{Binding TodosFilter, Converter={StaticResource FilterTabTextDecorationConverter}, ConverterParameter=active}"/>
                            </Button>
                            <Button Click="TodosFilterTab_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Tag="scheduled"
                                    Opacity="{Binding TodosFilter, Converter={StaticResource FilterTabOpacityConverter}, ConverterParameter=scheduled}"
                                    FontWeight="{Binding TodosFilter, Converter={StaticResource FilterTabFontWeightConverter}, ConverterParameter=scheduled}">
                                <TextBlock Text="scheduled"
                                           TextDecorations="{Binding TodosFilter, Converter={StaticResource FilterTabTextDecorationConverter}, ConverterParameter=scheduled}"/>
                            </Button>
                            <Button Click="TodosFilterTab_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Tag="completed"
                                    Opacity="{Binding TodosFilter, Converter={StaticResource FilterTabOpacityConverter}, ConverterParameter=completed}"
                                    FontWeight="{Binding TodosFilter, Converter={StaticResource FilterTabFontWeightConverter}, ConverterParameter=completed}">
                                <TextBlock Text="completed"
                                           TextDecorations="{Binding TodosFilter, Converter={StaticResource FilterTabTextDecorationConverter}, ConverterParameter=completed}"/>
                            </Button>
                            <Button Click="TodosFilterTab_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Tag="hidden"
                                    Opacity="{Binding TodosFilter, Converter={StaticResource FilterTabOpacityConverter}, ConverterParameter=hidden}"
                                    FontWeight="{Binding TodosFilter, Converter={StaticResource FilterTabFontWeightConverter}, ConverterParameter=hidden}">
                                <TextBlock Text="hidden"
                                           TextDecorations="{Binding TodosFilter, Converter={StaticResource FilterTabTextDecorationConverter}, ConverterParameter=hidden}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBox Grid.Row="1" Watermark="Add To-do"
                             HorizontalAlignment="Stretch"
                             Text="{Binding NewTodoTitle}"
                             KeyDown="AddTodo_KeyDown"
                             Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Todos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="tasks:TodoTask">
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                        <Button Grid.Column="0" 
                                                Click="EditTask_Click" 
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="8,6"
                                                Opacity="{Binding IsRewardGoalMet, Converter={StaticResource BoolToOpacityConverter}}">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding}">
                                                    <MenuItem Header="Set as Current Activity" Click="ContextMenu_SetCurrentActivity_Click"/>
                                                    <MenuItem Header="{Binding IsHidden, Converter={StaticResource HiddenToggleLabelConverter}}"
                                                              Click="ContextMenu_ToggleHidden_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid RowDefinitions="Auto,Auto">
                                                <TextBlock Text="{Binding Title}"
                                                           TextWrapping="Wrap"
                                                           TextDecorations="{Binding IsRewardGoalMet, Converter={StaticResource BoolToTextDecorationConverter}}">
                                                    <TextBlock.Foreground>
                                                        <MultiBinding Converter="{StaticResource TodoOverdueForegroundConverter}">
                                                            <Binding Path="DueDate"/>
                                                            <Binding Path="IsRewardGoalMet"/>
                                                        </MultiBinding>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                                <TextBlock Grid.Row="1" 
                                                           Text="{Binding DueDate, Converter={StaticResource DueDateDisplayConverter}}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Left"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,4,0,0">
                                                    <TextBlock.IsVisible>
                                                        <MultiBinding Converter="{StaticResource NotNullAndBooleanMultiConverter}">
                                                            <Binding Path="DueDate"/>
                                                            <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).IsVerbose"/>
                                                        </MultiBinding>
                                                    </TextBlock.IsVisible>
                                                </TextBlock>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Content="&#x2713;" Click="CompleteTask_Click" Margin="4,0,0,0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsEnabled="{Binding IsRewardGoalMet, Converter={StaticResource InverseBooleanConverter}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Rewards -->
            <Border Grid.Column="3"
                    Background="{DynamicResource ColumnBackgroundBrush}"
                    CornerRadius="6"
                    Padding="12"
                    Margin="6,0,0,0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid RowDefinitions="Auto,Auto" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Text="Rewards"
                                       Classes="column-title"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextBrush}"/>
                            <ComboBox Grid.Column="1"
                                      Classes="sort-dropdown"
                                      ItemsSource="{Binding RewardsSortOptions}"
                                      SelectedItem="{Binding RewardsSortMode}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Button Click="RewardsFilterTab_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Tag="all"
                                    Opacity="{Binding RewardsFilter, Converter={StaticResource FilterTabOpacityConverter}, ConverterParameter=all}"
                                    FontWeight="{Binding RewardsFilter, Converter={StaticResource FilterTabFontWeightConverter}, ConverterParameter=all}">
                                <TextBlock Text="all"
                                           TextDecorations="{Binding RewardsFilter, Converter={StaticResource FilterTabTextDecorationConverter}, ConverterParameter=all}"/>
                            </Button>
                            <Button Click="RewardsFilterTab_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Tag="one-time"
                                    Opacity="{Binding RewardsFilter, Converter={StaticResource FilterTabOpacityConverter}, ConverterParameter='one-time'}"
                                    FontWeight="{Binding RewardsFilter, Converter={StaticResource FilterTabFontWeightConverter}, ConverterParameter='one-time'}">
                                <TextBlock Text="one-time"
                                           TextDecorations="{Binding RewardsFilter, Converter={StaticResource FilterTabTextDecorationConverter}, ConverterParameter='one-time'}"/>
                            </Button>
                            <Button Click="RewardsFilterTab_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Tag="repeatable"
                                    Opacity="{Binding RewardsFilter, Converter={StaticResource FilterTabOpacityConverter}, ConverterParameter=repeatable}"
                                    FontWeight="{Binding RewardsFilter, Converter={StaticResource FilterTabFontWeightConverter}, ConverterParameter=repeatable}">
                                <TextBlock Text="repeatable"
                                           TextDecorations="{Binding RewardsFilter, Converter={StaticResource FilterTabTextDecorationConverter}, ConverterParameter=repeatable}"/>
                            </Button>
                            <Button Click="RewardsFilterTab_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Tag="hidden"
                                    Opacity="{Binding RewardsFilter, Converter={StaticResource FilterTabOpacityConverter}, ConverterParameter=hidden}"
                                    FontWeight="{Binding RewardsFilter, Converter={StaticResource FilterTabFontWeightConverter}, ConverterParameter=hidden}">
                                <TextBlock Text="hidden"
                                           TextDecorations="{Binding RewardsFilter, Converter={StaticResource FilterTabTextDecorationConverter}, ConverterParameter=hidden}"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBox Grid.Row="1" Watermark="Add Reward"
                             HorizontalAlignment="Stretch"
                             Text="{Binding NewRewardTitle}"
                             KeyDown="AddReward_KeyDown"
                             Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Rewards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="rewards:Reward">
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                        <Button Grid.Column="0" 
                                                Click="EditTask_Click" 
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="8,6">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding}">
                                                    <MenuItem Header="Set as Current Activity" Click="ContextMenu_SetCurrentActivity_Click"/>
                                                    <MenuItem Header="{Binding IsHidden, Converter={StaticResource HiddenToggleLabelConverter}}"
                                                              Click="ContextMenu_ToggleHidden_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid RowDefinitions="Auto,Auto">
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="1" 
                                                           Text="{Binding GoldCost, StringFormat='{}{0:0.#}G'}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource GoldTextBrush}"
                                                           Margin="0,4,0,0"
                                                           IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsVerbose}"/>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Content="Take" Click="ClaimReward_Click" Margin="4,0,0,0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer / Current Activity and User/Balance/Vacation -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" Margin="0,12,0,0">
            <Border Grid.Column="0" Grid.ColumnSpan="2"
                    Background="{DynamicResource ColumnBackgroundBrush}" 
                    BorderBrush="{DynamicResource ActivityBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="12"
                    Margin="0,0,6,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Current Activity" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}"/>
                        <TextBox Watermark="Activity title..." Text="{Binding CurrentActivity.Title}" KeyDown="ActivityTitle_KeyDown" HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*,*" RowSpacing="6" ColumnSpacing="6" VerticalAlignment="Center">
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Text="{Binding CurrentActivity.ElapsedDisplay}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Stretch" TextAlignment="Center" Foreground="{DynamicResource AppTextBrush}"/>
                        <Button x:Name="StartActivityButton" Grid.Row="1" Grid.Column="0" Content="{Binding CurrentActivity.StartButtonLabel}" Click="StartActivity_Click" IsEnabled="{Binding CurrentActivity.IsRunning, Converter={StaticResource InverseBooleanConverter}}"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Pause" Click="PauseActivity_Click" IsEnabled="{Binding CurrentActivity.IsRunning}"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="Reset" Click="ResetActivity_Click"/>
                        <Button Grid.Row="1" Grid.Column="3" Content="Remove" Click="RemoveActivity_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- User, Balance, and Vacation Mode -->
            <StackPanel Grid.Column="3"
                        Spacing="8"
                        Margin="6,0,0,0">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Border Grid.Column="0"
                            Background="{DynamicResource ColumnBackgroundBrush}" 
                            BorderBrush="{DynamicResource GoldBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="User:" VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBlock Text="{Binding CurrentUserName}" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{DynamicResource ColumnBackgroundBrush}" 
                            BorderBrush="{DynamicResource GoldBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="Balance:" VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}"/>
                            <TextBlock Text="{Binding User.Gold, StringFormat='{}{0:0.0} G'}" FontWeight="Bold" Foreground="{DynamicResource GoldTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Vacation Mode Toggle -->
                <Button Click="ToggleVacationMode_Click"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="12,8"
                        CornerRadius="6"
                        ToolTip.Tip="{Binding VacationModeTooltip}">
                    <Panel>
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding IsVacationMode}">
                            <TextBlock Text="&#x1F3D6;&#xFE0F;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="On Vacation" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    IsVisible="{Binding IsVacationMode, Converter={StaticResource InverseBooleanConverter}}">
                            <TextBlock Text="&#x1F4BC;" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Working" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextBrush}"/>
                        </StackPanel>
                    </Panel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
 
</Window>
