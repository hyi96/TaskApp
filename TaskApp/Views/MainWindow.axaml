<Window xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:vm="using:TaskApp.ViewModels"
         xmlns:tasks="using:TaskApp.Models.Tasks"
         xmlns:rewards="using:TaskApp.Models.Rewards"
         xmlns:conv="using:TaskApp.Converters"
         mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
         x:Class="TaskApp.Views.MainWindow"
         x:Name="MainWindowRoot"
         x:DataType="vm:MainWindowViewModel"
         Width="1000"
                 Height="600"
                 MinWidth="800"
                 MinHeight="450"
                 Title="TaskApp">
     <Window.Resources>
         <conv:BooleanNegationConverter x:Key="InverseBooleanConverter" />
         <conv:BooleanToTextDecorationConverter x:Key="BoolToTextDecorationConverter" />
     </Window.Resources>
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0"
                       Text="TaskApp"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="8">
                <TextBox Width="300" Watermark="Search tasks..." Text="{Binding SearchQuery}"/>
                <Button Content="Tags"
                        Click="OpenTagsWindow_Click"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Content="Graphs"
                    Click="OpenGraphWindow_Click"
                    VerticalAlignment="Center"/>

            <Button Grid.Column="3"
                    Content="Logs"
                    Click="OpenLogsWindow_Click"
                    VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*">
            <!-- Habits -->
            <Border Grid.Column="0"
                    Background="#F5F5F5"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,6,0">
                <StackPanel Spacing="12">
                    <TextBlock Text="Habits"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBox Watermark="Add Habit"
                             HorizontalAlignment="Stretch"
                             Text="{Binding NewHabitTitle}"
                             KeyDown="AddHabit_KeyDown"/>
                    <ItemsControl ItemsSource="{Binding Habits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tasks:HabitTask">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Button Grid.Column="0" 
                                            Content="{Binding Title}" 
                                            Click="EditTask_Click" 
                                            HorizontalAlignment="Stretch"
                                            Margin="0,2"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="4,0,0,0">
                                        <TextBlock Text="{Binding Count}" VerticalAlignment="Center" Margin="0,0,4,0" MinWidth="20" TextAlignment="Center"/>
                                        <Button Content="+" Click="IncrementHabit_Click" Padding="8,4" VerticalAlignment="Stretch" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Dailies -->
            <Border Grid.Column="1"
                    Background="#F5F5F5"
                    CornerRadius="6"
                    Padding="12"
                    Margin="6,0,6,0">
                <StackPanel Spacing="12">
                    <TextBlock Text="Dailies"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBox Watermark="Add Daily"
                             HorizontalAlignment="Stretch"
                             Text="{Binding NewDailyTitle}"
                             KeyDown="AddDaily_KeyDown"/>
                    <ItemsControl ItemsSource="{Binding Dailies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tasks:DailyTask">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Button Grid.Column="0" 
                                            Click="EditTask_Click" 
                                            HorizontalAlignment="Stretch"
                                            Margin="0,2">
                                        <Button.Content>
                                            <TextBlock Text="{Binding Title}"
                                                       TextDecorations="{Binding IsCompleteForCurrentPeriod, Converter={StaticResource BoolToTextDecorationConverter}}"/>
                                        </Button.Content>
                                    </Button>
                                    <Button Grid.Column="1" Content="&#x2713;" Click="CompleteTask_Click" Margin="4,2,0,2" IsEnabled="{Binding IsCompleteForCurrentPeriod, Converter={StaticResource InverseBooleanConverter}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- To-dos -->
            <Border Grid.Column="2"
                    Background="#F5F5F5"
                    CornerRadius="6"
                    Padding="12"
                    Margin="6,0,6,0">
                <StackPanel Spacing="12">
                    <TextBlock Text="To-dos"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBox Watermark="Add To-do"
                             HorizontalAlignment="Stretch"
                             Text="{Binding NewTodoTitle}"
                             KeyDown="AddTodo_KeyDown"/>
                    <ItemsControl ItemsSource="{Binding Todos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tasks:TodoTask">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Button Grid.Column="0" 
                                            Content="{Binding Title}" 
                                            Click="EditTask_Click" 
                                            HorizontalAlignment="Stretch"
                                            Margin="0,2"/>
                                    <Button Grid.Column="1" Content="&#x2713;" Click="CompleteTask_Click" Margin="4,2,0,2"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Rewards -->
            <Border Grid.Column="3"
                    Background="#F5F5F5"
                    CornerRadius="6"
                    Padding="12"
                    Margin="6,0,0,0">
                <StackPanel Spacing="12">
                    <TextBlock Text="Rewards"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBox Watermark="Add Reward"
                             HorizontalAlignment="Stretch"
                             Text="{Binding NewRewardTitle}"
                             KeyDown="AddReward_KeyDown"/>
                    <ItemsControl ItemsSource="{Binding Rewards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="rewards:Reward">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Button Grid.Column="0" 
                                            Content="{Binding Title}" 
                                            Click="EditTask_Click" 
                                            HorizontalAlignment="Stretch"
                                            Margin="0,2"/>
                                    <Button Grid.Column="1" Content="Claim" Click="ClaimReward_Click" Margin="4,2,0,2"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer / Current Activity and Gold Counter -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <Border Background="#E8F5E9" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="4" Padding="12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,12,0"
                    MaxWidth="{Binding #MainWindowRoot.Bounds.Width}">
                <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Current Activity" FontWeight="SemiBold"/>
                        <TextBox Watermark="Activity title..." Text="{Binding CurrentActivity.Title}" KeyDown="ActivityTitle_KeyDown" HorizontalAlignment="Stretch" MinWidth="280"/>
                    </StackPanel>

                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*,*" RowSpacing="6" ColumnSpacing="6" VerticalAlignment="Center">
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Text="{Binding CurrentActivity.ElapsedDisplay}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Stretch" TextAlignment="Center"/>
                        <Button x:Name="StartActivityButton" Grid.Row="1" Grid.Column="0" Content="Start" Click="StartActivity_Click" IsEnabled="{Binding CurrentActivity.IsRunning, Converter={StaticResource InverseBooleanConverter}}"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Pause" Click="PauseActivity_Click" IsEnabled="{Binding CurrentActivity.IsRunning}"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="Reset" Click="ResetActivity_Click"/>
                        <Button Grid.Row="1" Grid.Column="3" Content="Remove" Click="RemoveActivity_Click"/>
                    </Grid>
                </Grid>
            </Border>
 
             <Border Grid.Column="1" Background="#FFF8E1" BorderBrush="#FFD54F" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right">
                 <StackPanel Orientation="Horizontal" Spacing="4">
                     <TextBlock Text="Balance:" VerticalAlignment="Center"/>
                     <TextBlock Text="{Binding User.Gold, StringFormat='{}{0:0.0} G'}" FontWeight="Bold" Foreground="#F57F17" VerticalAlignment="Center"/>
                 </StackPanel>
             </Border>
         </Grid>
     </Grid>
 
 </Window>
