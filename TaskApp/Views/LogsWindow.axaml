<Window xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:TaskApp.ViewModels"
mc:Ignorable="d"
x:Class="TaskApp.Views.LogsWindow"
x:DataType="vm:LogsViewModel"
Icon="/Assets/app-icon.png"
d:DesignWidth="600"
d:DesignHeight="400"
Width="560"
Height="640"
Title="Logs"
Background="{DynamicResource AppBackgroundBrush}">
    <Border Padding="16">
        <Grid RowDefinitions="Auto,Auto,*">
            <TextBlock Text="Recent Logs" FontSize="24" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource AppTextBrush}"/>

            <WrapPanel Grid.Row="1" Margin="0,0,0,12" Orientation="Horizontal">
                <TextBlock Text="Show last" VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}" Margin="0,4,8,4"/>
                <ComboBox ItemsSource="{Binding LimitOptions}" SelectedItem="{Binding SelectedLimit}" Width="80" VerticalAlignment="Center" Margin="0,4,8,4"/>
                <TextBlock Text="from" VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}" Margin="0,4,8,4"/>
                <DatePicker SelectedDate="{Binding FromDate}" VerticalAlignment="Center" Margin="0,4,8,4"/>
                <TextBlock Text="to" VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}" Margin="0,4,8,4"/>
                <DatePicker SelectedDate="{Binding ToDate}" VerticalAlignment="Center" Margin="0,4,8,4"/>
                <Button Content="Apply" Click="ApplyFilter_Click" VerticalAlignment="Center" Margin="0,4,0,4"/>
                <ToggleButton Content="Undo" IsChecked="{Binding IsUndoMode}" VerticalAlignment="Center" Margin="8,4,0,4"/>
            </WrapPanel>

            <ScrollViewer Grid.Row="2" Margin="0,0,12,0">
                <ItemsControl ItemsSource="{Binding Logs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntryViewModel">
                            <Border Padding="8" Margin="0,0,0,6" BorderBrush="{DynamicResource LogBorderBrush}" BorderThickness="0 0 0 1">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Button Grid.Column="0"
                                            Content="↩"
                                            Padding="6,2"
                                            FontSize="12"
                                            Click="UndoEntry_Click"
                                            IsVisible="{Binding $parent[Window].((vm:LogsViewModel)DataContext).IsUndoMode}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Timestamp}" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
