<Window xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:TaskApp.ViewModels"
mc:Ignorable="d"
x:Class="TaskApp.Views.LogsWindow"
x:DataType="vm:LogsViewModel"
Icon="/Assets/app-icon.png"
d:DesignWidth="600"
d:DesignHeight="400"
Width="640"
Height="480"
Title="Logs"
Background="{DynamicResource AppBackgroundBrush}">
    <Border Padding="16">
        <Grid RowDefinitions="Auto,Auto,*">
            <TextBlock Text="Recent Logs" FontSize="24" FontWeight="Bold" Margin="0,0,0,12" Foreground="{DynamicResource AppTextBrush}"/>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" Margin="0,0,0,12" ColumnSpacing="8">
                <TextBlock Text="Show last" VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding LimitOptions}" SelectedItem="{Binding SelectedLimit}" Width="80" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="from" VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}"/>
                <DatePicker Grid.Column="3" SelectedDate="{Binding FromDate}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="to" VerticalAlignment="Center" Foreground="{DynamicResource AppTextBrush}"/>
                <DatePicker Grid.Column="5" SelectedDate="{Binding ToDate}" VerticalAlignment="Center"/>
                <Button Grid.Column="6" Content="Apply" Click="ApplyFilter_Click" VerticalAlignment="Center"/>
            </Grid>

            <ScrollViewer Grid.Row="2" Margin="0,0,12,0">
                <ItemsControl ItemsSource="{Binding Logs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntryViewModel">
                            <Border Padding="8" Margin="0,0,0,6" BorderBrush="{DynamicResource LogBorderBrush}" BorderThickness="0 0 0 1">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <TextBlock Grid.Column="0" Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource AppTextBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Timestamp}" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
