<Window xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:TaskApp.ViewModels"
mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
x:Class="TaskApp.Views.TaskFormWindow"
x:DataType="vm:TaskFormViewModel"
Icon="/Assets/app-icon.png"
Title="{Binding FormTitle}"
Width="400" Height="600"
WindowStartupLocation="CenterOwner"
Background="{DynamicResource AppBackgroundBrush}">


    <Window.DataTemplates>
        <!-- Habit Template -->
        <DataTemplate DataType="{x:Type vm:HabitFormViewModel}">
            <StackPanel Spacing="12">
                <TextBlock Text="Habit Settings" FontWeight="SemiBold"/>
                
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="Count" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Column="1" Value="{Binding Count}" Minimum="0" Increment="1" Width="120" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Text="Increment Amount" VerticalAlignment="Center"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding IncrementAmount}" Minimum="0.1" Increment="0.5" Width="120"/>

                    <TextBlock Grid.Row="2" Text="Reset Counter" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              ItemsSource="{Binding ResetCadenceOptions}"
                              SelectedItem="{Binding ResetCadence}"
                              Width="140"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Daily Template -->
        <DataTemplate DataType="{x:Type vm:DailyFormViewModel}">
            <StackPanel Spacing="12">
                <TextBlock Text="Daily Settings" FontWeight="SemiBold"/>
                
                <StackPanel>
                    <TextBlock Text="Repeat Cadence"/>
                    <ComboBox ItemsSource="{Binding CadenceOptions}" 
                              SelectedItem="{Binding Cadence}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Repeat Every"/>
                    <NumericUpDown Value="{Binding RepeatEvery}" Minimum="1" Increment="1"/>
                </StackPanel>
                
                <StackPanel>
                    <TextBlock Text="Current Streak"/>
                    <NumericUpDown Value="{Binding CurrentStreak}" Minimum="0" Increment="1"/>
                </StackPanel>
                
                <StackPanel>
                    <TextBlock Text="Best Streak"/>
                    <TextBlock Text="{Binding BestStreak}"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Streak Protection Cost"/>
                    <NumericUpDown Value="{Binding StreakProtectionCost}" Minimum="0" Increment="0.5" FormatString="F1"/>
                </StackPanel>

                <Separator Height="1" Background="#E0E0E0"/>

                <StackPanel Spacing="8">
                    <CheckBox Content="Autocomplete based on time spent" IsChecked="{Binding IsAutocompleteEnabled}"/>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" IsVisible="{Binding IsAutocompleteEnabled}">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Hours"/>
                            <NumericUpDown Value="{Binding AutocompleteHours}" Minimum="0" Increment="1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Minutes"/>
                            <NumericUpDown Value="{Binding AutocompleteMinutes}" Minimum="0" Maximum="59" Increment="1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Seconds"/>
                            <NumericUpDown Value="{Binding AutocompleteSeconds}" Minimum="0" Maximum="59" Increment="1"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Separator Height="1" Background="#E0E0E0"/>

                <StackPanel Spacing="8">
                    <TextBlock Text="Streak Bonus Rules" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="2*,2*,Auto" RowDefinitions="Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Streak Goal"/>
                            <NumericUpDown Value="{Binding NewBonusStreakGoal}" Minimum="1" Increment="1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Bonus %"/>
                            <NumericUpDown Value="{Binding NewBonusPercent}" Minimum="0" Increment="1"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="Add" Margin="8,20,0,0" Click="AddStreakBonusRule_Click"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding StreakBonusRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,*,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding StreakGoal, StringFormat='Streak ? {0}'}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BonusPercent, StringFormat='+{0}% gold'}"/>
                                    <Button Grid.Column="2" Content="Remove" Click="RemoveStreakBonusRule_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Todo Template -->
        <DataTemplate DataType="{x:Type vm:TodoFormViewModel}">
            <StackPanel Spacing="12">
                <TextBlock Text="Todo Settings" FontWeight="SemiBold"/>

                <StackPanel>
                    <TextBlock Text="Due Date"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <DatePicker SelectedDate="{Binding DueDate}"/>
                        <Button Grid.Column="1" Content="Clear" Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                IsVisible="{Binding DueDate, Converter={x:Static ObjectConverters.IsNotNull}}"
                                Click="ClearDueDate_Click"/>
                    </Grid>
                </StackPanel>

                <StackPanel IsVisible="{Binding DueDate, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="Due Time"/>
                    <TimePicker SelectedTime="{Binding DueTime}"
                                ClockIdentifier="24HourClock"
                                MinuteIncrement="1"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Checklist"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding NewChecklistItem}"
                                 Watermark="Add checklist item..."
                                 KeyDown="AddChecklistItem_KeyDown"/>
                        <Button Grid.Column="1"
                                Content="Add"
                                Margin="4,0,0,0"
                                Click="AddChecklistItem_Click"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ChecklistItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsCompleted}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="2"
                                            Content="X"
                                            Padding="6,2"
                                            Background="#B00020"
                                            Foreground="White"
                                            Click="RemoveChecklistItem_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Reward Template -->
        <DataTemplate DataType="{x:Type vm:RewardFormViewModel}">
            <StackPanel Spacing="12">
                <TextBlock Text="Reward Settings" FontWeight="SemiBold"/>

                <CheckBox Content="Is Repeatable" IsChecked="{Binding IsRepeatable}"/>
            </StackPanel>
        </DataTemplate>
    </Window.DataTemplates>

    <Border Padding="16">
        <Grid RowDefinitions="Auto,*,Auto">

            <TextBlock Text="{Binding FormTitle}"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,16"
                       Foreground="{DynamicResource AppTextBrush}"/>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" Margin="0,0,0,16">
                <StackPanel Spacing="16" Margin="0,0,20,0">

                    <!-- Common Fields -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Title" FontWeight="Medium"/>
                        <TextBox Text="{Binding Title}" Watermark="Task Title"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Notes" FontWeight="Medium"/>
                        <TextBox Text="{Binding Notes}" Watermark="Add notes..." AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="Tags" FontWeight="Medium" VerticalAlignment="Top" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedTagsDisplay}" 
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"/>
                        </Grid>
                        <Button Content="Select Tags" 
                                HorizontalAlignment="Stretch" 
                                HorizontalContentAlignment="Left">
                            <Button.Flyout>
                                <Flyout Placement="Bottom" ShowMode="Standard">
                                    <Border Background="{DynamicResource ColumnBackgroundBrush}" 
                                            Padding="8" 
                                            CornerRadius="4">
                                        <ScrollViewer MaxHeight="300" MinWidth="200">
                                            <ItemsControl ItemsSource="{Binding TaskTags}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected}" 
                                                                  Content="{Binding Name}" 
                                                                  Margin="0,4"
                                                                  Foreground="{DynamicResource AppTextBrush}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Gold Value" FontWeight="Medium"/>
                        <NumericUpDown Value="{Binding GoldValue}" Minimum="0" Increment="0.1"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Last Completed" FontWeight="Medium"/>
                        <TextBlock Text="{Binding LastCompletedDisplay}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>

                    <Separator Height="1" Background="#E0E0E0"/>

                    <!-- Specific Fields -->
                    <ContentControl Content="{Binding}"/>

                    <!-- Manual Activity Duration Logging -->
                    <Separator Height="1" Background="#E0E0E0" Margin="0,8,0,0"/>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Log Activity Duration" FontWeight="Medium"/>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Hours" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <NumericUpDown Value="{Binding ManualHours}" Minimum="0" Increment="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Minutes" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <NumericUpDown Value="{Binding ManualMinutes}" Minimum="0" Maximum="59" Increment="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Seconds" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <NumericUpDown Value="{Binding ManualSeconds}" Minimum="0" Maximum="59" Increment="1"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="Log Duration"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="LogManualDuration_Click"/>
                        <TextBlock Text="{Binding ManualDurationStatus}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12"
                                   IsVisible="{Binding ManualDurationStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button Grid.Column="0"
                        Content="Delete"
                        Background="#B00020"
                        Foreground="White"
                        Click="Delete_Click"/>

                <Button Grid.Column="1"
                        Content="Set as Current Activity"
                        Margin="8,0"
                        Click="SetCurrentActivity_Click"/>

                <Button Grid.Column="3"
                        Content="Cancel"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>

                <Button Grid.Column="4"
                        Content="Save"
                        Background="#404040"
                        Foreground="White"
                        Click="Save_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
