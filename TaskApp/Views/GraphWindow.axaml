<Window xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:TaskApp.ViewModels"
xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
x:Class="TaskApp.Views.GraphWindow"
x:DataType="vm:GraphViewModel"
Icon="/Assets/app-icon.png"
Title="Graphs"
Width="1200" Height="700"
Background="{DynamicResource AppBackgroundBrush}">
<Border Background="{DynamicResource ColumnBackgroundBrush}" Padding="12" Margin="16" CornerRadius="6">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <TextBlock Grid.Row="0"
                   Text="Graphical Insights"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,4"
                   Foreground="{DynamicResource AppTextBrush}"/>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,0,0,4">
                <Button Content="Hour" Click="Hour_Click"/>
                <Button Content="Day" Click="Day_Click"/>
                <Button Content="Week" Click="Week_Click"/>
                <Button Content="Month" Click="Month_Click"/>
                <Button Content="Year" Click="Year_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox Width="160"
                              ItemsSource="{Binding TargetTypes}"
                              SelectedItem="{Binding SelectedTargetType}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Width="220"
                              ItemsSource="{Binding TargetValues}"
                              SelectedItem="{Binding SelectedTargetValue}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Width="260"
                              ItemsSource="{Binding TargetInstances}"
                              SelectedItem="{Binding SelectedTargetInstance}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="350"
                                 Watermark="Search target instance..."
                                 Text="{Binding SearchQuery}"/>
                        <Button Content="Merge"
                                Click="Merge_Click"
                                VerticalAlignment="Center"
                                IsVisible="{Binding CanMerge}"
                                ToolTip.Tip="Merge orphaned activity log entries into the matching task or reward so their durations are tracked together."/>
                    </StackPanel>
                    <ListBox Width="350"
                             MaxHeight="140"
                             HorizontalAlignment="Left"
                             ItemsSource="{Binding SearchResults}"
                             SelectedItem="{Binding SelectedSearchResult}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
                <sp:AvaPlot Name="GraphPlot"/>
            </Border>
        </Grid>
    </Border>
</Window>
